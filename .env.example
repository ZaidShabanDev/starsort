# Copy this file to .env and fill in the values. Never commit .env.

# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour.
# Create one at https://github.com/settings/tokens (no scopes needed for public stars).
# --sync-lists needs a CLASSIC token with the 'user' scope (fine-grained tokens can't create lists).
GITHUB_TOKEN=

# Amazon Bedrock (default model provider).
# Keys live in your AWS profile (~/.aws), never in this file. See infra/ to create the profile's user.
AWS_PROFILE=starsort
AWS_REGION=us-west-2

# Optional: change the AI provider or model (same as --provider / --model).
# STARSORT_PROVIDER=bedrock
# STARSORT_MODEL=us.anthropic.claude-opus-5-5

# Only for STARSORT_PROVIDER=anthropic (also run: uv sync --extra anthropic)
# ANTHROPIC_API_KEY=
