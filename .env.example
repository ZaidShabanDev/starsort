# Copy this file to .env and fill in the values. Never commit .env.

# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour.
# Create one at https://github.com/settings/tokens (no scopes needed for public stars).
GITHUB_TOKEN=

# Amazon Bedrock (default model provider).
# Keys live in your AWS profile (~/.aws), never in this file. See infra/ to create the profile's user.
AWS_PROFILE=starsort
AWS_REGION=us-west-2
